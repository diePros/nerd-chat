{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sine-loco-site",
  // Not a secret (it appears in dashboard URLs). Setting it here means CI only needs an API token.
  "account_id": "50fc7af9b9f3e256b5662c3cf6227ad4",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    // GitHub "owner/name". Change after the repository rename.
    "REPO": "diePros/nerd-chat"
  },
  "kv_namespaces": [
    // Holds the daily star samples. Pinned so CI deploys reuse it instead of provisioning a new one.
    { "binding": "STATS", "id": "e741349c1c66485b9b7f5d73bddac525" }
  ],
  "triggers": { "crons": ["0 4 * * *"] },
  // Custom domain: Cloudflare creates the DNS record and certificate on deploy.
  // The zone must be in the same Cloudflare account.
  "routes": [
    { "pattern": "sineloco.dev", "custom_domain": true },
    // Only redirects to the bare domain (see src/worker.ts).
    { "pattern": "www.sineloco.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "traces": { "enabled": true } }
}
