<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      RECEIVE_BOOT_COMPLETED: the key-erase job (EraseJobService) is rescheduled after a reboot.
      INTERNET: needed by the embedded tor (libtor.so, a child process of this app) and by nothing else: the app opens no socket itself except tor's unix sockets in its private
      directory, no WebView, no HTTP client, no DNS. Android cannot restrict a uid to "tor only", so this is a design rule, not a permission: see docs/ANDROID_PORT.md 3.1.
      FOREGROUND_SERVICE and POST_NOTIFICATIONS arrive with the foreground service (docs/ANDROID_PORT.md phase P4).
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- only to be told WHEN the phone's network goes away or comes back (ConnectivityManager callback): tor is paused meanwhile -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- the foreground service that keeps the app reachable (ConnectionService), its Android 14 type, and the notification it must show (Android 13+ asks the user) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SineLocoApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.SineLoco"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">

        <service
            android:name=".ConnectionService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <service
            android:name=".EraseJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density|fontScale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- a pairing link or QR code opened from the camera or another app (sineloco:pair/..., sineloco:lan/...): the app only PRE-FILLS the pairing form with it, the user presses Pair -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sineloco" />
            </intent-filter>
        </activity>
    </application>
</manifest>
